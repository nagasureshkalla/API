<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Image Studio</title>
    <style>
        :root {
            --bg: #f6f4ef;
            --panel: #ffffff;
            --ink: #1e2328;
            --muted: #66706a;
            --line: #d8ddd5;
            --accent: #0f766e;
            --accent-strong: #0b5f59;
            --accent-soft: #dff3ef;
            --warn: #a34716;
            --shadow: 0 18px 45px rgba(29, 36, 33, 0.12);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            background:
                linear-gradient(180deg, rgba(255,255,255,0.62), rgba(255,255,255,0)),
                var(--bg);
        }

        button,
        input,
        textarea {
            font: inherit;
        }

        .shell {
            width: min(1500px, 90vw);
            min-height: 90vh;
            margin: 0 auto;
            padding: 3vh 0;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 22px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .mark {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            background: var(--accent-soft);
            color: var(--accent-strong);
            border: 1px solid #c4e7df;
        }

        .brand h1 {
            margin: 0;
            font-size: clamp(24px, 4vw, 38px);
            line-height: 1;
            letter-spacing: 0;
        }

        .brand p {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .status {
            min-width: 132px;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: rgba(255,255,255,0.72);
            color: var(--muted);
            text-align: center;
            font-size: 13px;
        }

        .workspace {
            display: grid;
            grid-template-columns: minmax(390px, 32%) minmax(0, 1fr);
            gap: 18px;
            align-items: stretch;
            min-height: 68vh;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .controls {
            padding: 20px;
        }

        .field {
            margin-bottom: 16px;
        }

        .field label {
            display: block;
            margin-bottom: 8px;
            color: #3a433f;
            font-weight: 700;
            font-size: 13px;
        }

        textarea {
            width: 100%;
            min-height: 260px;
            resize: vertical;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 13px 14px;
            color: var(--ink);
            background: #fbfcfa;
            outline: none;
            line-height: 1.45;
        }

        textarea:focus,
        input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.14);
        }

        .file-drop {
            position: relative;
            display: grid;
            place-items: center;
            min-height: 118px;
            padding: 18px;
            border: 1px dashed #9db7ad;
            border-radius: 8px;
            background: #fbfcfa;
            text-align: center;
            color: var(--muted);
        }

        .file-drop input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

        .file-title {
            margin: 0 0 6px;
            color: var(--ink);
            font-weight: 800;
        }

        .file-name {
            margin: 0;
            font-size: 13px;
        }

        .toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 0 18px;
            color: var(--muted);
            font-size: 14px;
        }

        .switch {
            position: relative;
            width: 48px;
            height: 28px;
            flex: 0 0 auto;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            border-radius: 999px;
            background: #cfd7d1;
            transition: 180ms ease;
        }

        .slider::before {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: white;
            box-shadow: 0 1px 4px rgba(0,0,0,0.22);
            transition: 180ms ease;
        }

        .switch input:checked + .slider {
            background: var(--accent);
        }

        .switch input:checked + .slider::before {
            transform: translateX(20px);
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .btn {
            min-height: 46px;
            border: 0;
            border-radius: 8px;
            padding: 0 16px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-weight: 800;
        }

        .btn-primary {
            flex: 1;
            color: white;
            background: var(--accent);
        }

        .btn-primary:hover {
            background: var(--accent-strong);
        }

        .btn-secondary {
            width: 48px;
            color: var(--accent-strong);
            background: var(--accent-soft);
        }

        .btn:disabled {
            opacity: 0.62;
            cursor: wait;
        }

        .result {
            min-height: 68vh;
            display: grid;
            grid-template-rows: auto 1fr auto;
            overflow: hidden;
        }

        .result-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 18px;
            border-bottom: 1px solid var(--line);
        }

        .result-head h2 {
            margin: 0;
            font-size: 17px;
            letter-spacing: 0;
        }

        .meta {
            color: var(--muted);
            font-size: 13px;
        }

        .preview {
            position: relative;
            display: grid;
            place-items: center;
            min-height: 56vh;
            background:
                linear-gradient(45deg, #eef1ed 25%, transparent 25%),
                linear-gradient(-45deg, #eef1ed 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, #eef1ed 75%),
                linear-gradient(-45deg, transparent 75%, #eef1ed 75%),
                #f8faf7;
            background-position: 0 0, 0 10px, 10px -10px, -10px 0;
            background-size: 20px 20px;
        }

        .empty {
            width: min(360px, 80%);
            color: var(--muted);
            text-align: center;
            line-height: 1.5;
        }

        .preview img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
            display: none;
        }

        .result-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            border-top: 1px solid var(--line);
            background: #fbfcfa;
        }

        .message {
            color: var(--muted);
            font-size: 13px;
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .download {
            display: none;
            color: var(--accent-strong);
            text-decoration: none;
            font-weight: 800;
            font-size: 14px;
        }

        .is-error {
            color: var(--warn);
        }

        .gallery {
            margin-top: 18px;
            padding: 18px;
        }

        .gallery-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 14px;
        }

        .gallery-head h2 {
            margin: 0;
            font-size: 18px;
            letter-spacing: 0;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
            gap: 12px;
        }

        .gallery-item {
            overflow: hidden;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: #fbfcfa;
        }

        .gallery-item a {
            display: block;
            color: inherit;
            text-decoration: none;
        }

        .gallery-item img {
            display: block;
            width: 100%;
            aspect-ratio: 1;
            object-fit: cover;
            background: #eef1ed;
        }

        .gallery-meta {
            padding: 9px 10px 10px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.35;
        }

        .gallery-name {
            color: var(--ink);
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .gallery-empty {
            padding: 24px;
            color: var(--muted);
            border: 1px dashed var(--line);
            border-radius: 8px;
            text-align: center;
        }

        @media (max-width: 900px) {
            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .workspace {
                grid-template-columns: 1fr;
            }

            .result {
                min-height: 520px;
            }

            .preview {
                min-height: 390px;
            }

            .shell {
                width: min(100% - 600px, 900px);
                min-height: auto;
                padding: 18px 0;
            }

            textarea {
                min-height: 220px;
            }
        }
    </style>
</head>
<body>
    <main class="shell">
        <header class="topbar">
            <div class="brand">
                <div class="mark" aria-hidden="true">
                    <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
                        <path d="M4 16.5V7.5L12 3L20 7.5V16.5L12 21L4 16.5Z" stroke="currentColor" stroke-width="1.8" />
                        <path d="M8 12H16M12 8V16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <h1>Trained Image Studio</h1>
                    <p>LoRA image generation workspace</p>
                </div>
            </div>
            <div class="status" id="status">Ready</div>
        </header>

        <section class="workspace">
            <form class="panel controls" id="generateForm">
                <div class="field">
                    <label for="prompt">Prompt</label>
                    <textarea id="prompt" name="prompt" placeholder="Create a full-body hero character, clean grey background, vibrant comic style..."></textarea>
                </div>

                <div class="field">
                    <label for="image">Reference Image</label>
                    <div class="file-drop" id="fileDrop">
                        <input type="file" id="image" name="image" accept="image/*">
                        <div>
                            <p class="file-title">Select image</p>
                            <p class="file-name" id="fileName">Optional</p>
                        </div>
                    </div>
                </div>

                <div class="toggle-row">
                    <span>Transparent background</span>
                    <label class="switch">
                        <input type="checkbox" id="removeBackground" name="remove_background">
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="actions">
                    <button class="btn btn-primary" type="submit" id="submitBtn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12H19M13 6L19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Generate
                    </button>
                    <button class="btn btn-secondary" type="button" id="clearBtn" title="Clear">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </button>
                </div>
            </form>

            <section class="panel result">
                <div class="result-head">
                    <h2>Result</h2>
                    <span class="meta" id="meta">1024 x 1024</span>
                </div>
                <div class="preview">
                    <p class="empty" id="emptyState">Generated image will appear here.</p>
                    <img id="generatedImage" alt="Generated result">
                </div>
                <div class="result-foot">
                    <div class="message" id="response">Waiting for a prompt.</div>
                    <a class="download" id="downloadLink" href="#" download>Download</a>
                </div>
            </section>
        </section>

        <section class="panel gallery">
            <div class="gallery-head">
                <h2>Generated Images</h2>
                <span class="meta" id="galleryCount">Loading</span>
            </div>
            <div class="gallery-grid" id="galleryGrid"></div>
        </section>
    </main>

    <script>
        const form = document.getElementById("generateForm");
        const imageInput = document.getElementById("image");
        const fileName = document.getElementById("fileName");
        const promptInput = document.getElementById("prompt");
        const removeBackground = document.getElementById("removeBackground");
        const submitBtn = document.getElementById("submitBtn");
        const clearBtn = document.getElementById("clearBtn");
        const statusText = document.getElementById("status");
        const response = document.getElementById("response");
        const generatedImage = document.getElementById("generatedImage");
        const emptyState = document.getElementById("emptyState");
        const downloadLink = document.getElementById("downloadLink");
        const meta = document.getElementById("meta");
        const galleryGrid = document.getElementById("galleryGrid");
        const galleryCount = document.getElementById("galleryCount");

        const formatBytes = (bytes) => {
            if (!bytes) {
                return "0 KB";
            }
            const kb = bytes / 1024;
            if (kb < 1024) {
                return `${kb.toFixed(1)} KB`;
            }
            return `${(kb / 1024).toFixed(2)} MB`;
        };

        const loadGallery = async () => {
            try {
                const result = await fetch("/api/images");
                const payload = await result.json();
                const images = payload.images || [];
                galleryCount.textContent = `${images.length} image${images.length === 1 ? "" : "s"}`;

                if (!images.length) {
                    galleryGrid.innerHTML = '<div class="gallery-empty">No generated images yet.</div>';
                    return;
                }

                galleryGrid.innerHTML = images.map((image) => `
                    <article class="gallery-item">
                        <a href="${image.url}" target="_blank" rel="noreferrer">
                            <img src="${image.url}" alt="${image.name}" loading="lazy">
                            <div class="gallery-meta">
                                <div class="gallery-name" title="${image.name}">${image.name}</div>
                                <div>${image.modified_label}</div>
                                <div>${formatBytes(image.file_size_bytes)}</div>
                            </div>
                        </a>
                    </article>
                `).join("");
            } catch (error) {
                galleryCount.textContent = "Unavailable";
                galleryGrid.innerHTML = '<div class="gallery-empty">Could not load generated images.</div>';
            }
        };

        imageInput.addEventListener("change", () => {
            const file = imageInput.files && imageInput.files[0];
            fileName.textContent = file ? file.name : "Optional";
        });

        clearBtn.addEventListener("click", () => {
            form.reset();
            fileName.textContent = "Optional";
            response.textContent = "Waiting for a prompt.";
            response.classList.remove("is-error");
            statusText.textContent = "Ready";
            generatedImage.removeAttribute("src");
            generatedImage.style.display = "none";
            emptyState.style.display = "block";
            downloadLink.style.display = "none";
        });

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const prompt = promptInput.value.trim();
            if (!prompt) {
                response.textContent = "Prompt is required.";
                response.classList.add("is-error");
                return;
            }

            const formData = new FormData();
            const imageFile = imageInput.files && imageInput.files[0];
            if (imageFile) {
                formData.append("image", imageFile);
            }
            formData.append("prompt", prompt);
            formData.append("remove_background", removeBackground.checked ? "1" : "0");

            submitBtn.disabled = true;
            statusText.textContent = "Generating";
            response.textContent = "Generating image...";
            response.classList.remove("is-error");

            try {
                const result = await fetch("/api/upload", {
                    method: "POST",
                    body: formData
                });
                const payload = await result.json();

                if (!result.ok) {
                    throw new Error(payload.message || payload.error || "Generation failed.");
                }

                const imageUrl = payload.output_image_url || payload.output_image;
                generatedImage.src = imageUrl;
                generatedImage.style.display = "block";
                emptyState.style.display = "none";
                downloadLink.href = imageUrl;
                downloadLink.style.display = "inline-flex";
                response.textContent = `${payload.message} ${payload.time_taken}`;
                meta.textContent = `${payload.width} x ${payload.height}`;
                statusText.textContent = "Complete";
                await loadGallery();
            } catch (error) {
                response.textContent = error.message;
                response.classList.add("is-error");
                statusText.textContent = "Error";
            } finally {
                submitBtn.disabled = false;
            }
        });

        loadGallery();
    </script>
</body>
</html>
